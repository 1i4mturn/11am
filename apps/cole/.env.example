BOLTON_API_URL=http://localhost:3002
ANTHROPIC_API_KEY=
BOLTON_SINGLE_USER=true
LEO_API_URL=http://localhost:3006

# OpenAI Whisper — transcription / auto-captions
OPENAI_API_KEY=

