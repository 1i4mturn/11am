# Copy sections into each Vercel project → Settings → Environment Variables
# Replace YOUR-* with real *.vercel.app URLs after each deploy.

# ═══ NEON (shared) — bolton · leo · marc · william · george ═══
DATABASE_URL=postgresql://USER:PASS@HOST/neondb?sslmode=require

# ═══ ALL AGENTS (most apps) ═══
ANTHROPIC_API_KEY=
BOLTON_API_URL=https://YOUR-BOLTON.vercel.app
NEXT_PUBLIC_HOME_URL=https://YOUR-HOME.vercel.app

# ═══ bolton ═══
OPENAI_API_KEY=

# ═══ leo ═══
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-LEO.vercel.app/api/calendar/callback
BOLTON_SINGLE_USER=true
JAMES_API_URL=https://YOUR-JAMES.vercel.app
CONNER_API_URL=https://YOUR-CONNER.vercel.app
ROBERT_API_URL=https://YOUR-ROBERT.vercel.app
HARRIS_API_URL=https://YOUR-HARRIS.vercel.app
COLE_API_URL=https://YOUR-COLE.vercel.app
JOHNNY_API_URL=https://YOUR-JOHNNY.vercel.app

# ═══ marc ═══
OPENAI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-MARC.vercel.app/api/gmail/callback
MARC_SINGLE_USER=true

# ═══ william ═══
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://YOUR-WILLIAM.vercel.app/api/gmail/callback

# ═══ george ═══
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=https://YOUR-GEORGE.vercel.app/api/xero/callback

# ═══ johnny (Vercel: UI + review API only — no Docker sandbox) ═══
JOHNNY_JOBS_ENABLED=false
GITHUB_TOKEN=
LEO_API_URL=https://YOUR-LEO.vercel.app

# ═══ home — deploy LAST (server + client URLs) ═══
MARC_API_URL=https://YOUR-MARC.vercel.app
WILLIAM_API_URL=https://YOUR-WILLIAM.vercel.app
LEO_API_URL=https://YOUR-LEO.vercel.app
